     [
      "bed",
      "bounce"
     ]
    ],
    "text": "KNOCK.",
    "sfx": "alarm"
   },
   {
    "who": "moore",
    "say": "Did William Kent poison you? With arsenic?",
    "cam": "close:moore",
    "do": [
     [
      "moore",
      "eyes_big"
     ]
    ],
    "text": "WILLIAM KENT?"
   },
   {
    "who": "narr",
    "say": "Knock.",
