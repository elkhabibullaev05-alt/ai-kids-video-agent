   "do": [
    [
     "odo",
     "turn:moth"
    ]
   ],
   "sfx": "horn",
   "text": "THEY NEVER CHANGED IT"
  },
  {
   "who": "narr",
   "say": "So, would YOU open the door, if your dog was hiding under the house?",
   "cam": "close:odo",
   "do": [
    [
     "odo",
     "eyes_big"
    ]
   ],
   "sfx": "alarm",
   "text": "WOULD YOU OPEN IT?"
  },
  {
   "who": "moth",
   "say": "Never. I would turn off the lantern and hide under the table.",
   "cam": "close:moth",
   "do": [
    [
     "moth",
     "shake"
    ]
   ]
  },
  {
   "who": "narr",
   "say": "Then the window glowed again. A pale hand was tapping on the glass.",
