 "beats": [
  {
   "who": "narr",
   "say": "Something was looking in the window. Two huge yellow eyes. And it was only three feet tall.",
   "cam": "close:gob",
   "do": [
    [
     "gob",
     "to:0.6,14.4,0"
    ],
    [
     "odo",
     "jump"
    ],
    [
     "gob",
     "turn:front"
    ]
   ],
   "sfx": "alarm",
   "text": "DON'T LOOK AT THE WINDOW"
  },
  {
   "who": "moth",
   "say": "Odo! It's pressing its face against the glass!",
   "cam": "close:moth",
   "do": [
    [
     "moth",
     "shake"
    ]
   ],
   "text": "IT'S AT THE GLASS"
  },
  {
   "who": "odo",
   "say": "Look at the ears, Mothwick. Huge and pointed. And its hands are like claws.",
   "cam": "close:gob",
   "do": [
    [
     "gob",
     "shake"
    ]
   ],
   "sfx": "suspicious",
   "text": "POINTED EARS. CLAWS."
  },
  {
   "who": "narr",
   "say": "This is a true story, from police and newspaper reports of nineteen fifty-five.",
   "cam": "wide",
   "do": [
    [
     "gob",
     "to:2.5,14.4,0"
    ]
   ],
   "text": "A TRUE STORY"
  },
  {
   "who": "narr",
   "say": "A farmhouse near Kelly, Kentucky. Two families were inside, and many children.",
   "cam": "overhead",
   "do": [
    [
     "odo",
     "turn:front"
    ]
   ],
   "text": "KENTUCKY, 1955"
  },
  {
   "who": "narr",
   "say": "August the twenty-first, about seven in the evening. Billy Ray went out to the well.",
   "cam": "wide",
   "do": [
    [
     "billy",
     "enter:left"
    ],
    [
     "gob",
     "to:30,30,0"
    ]
   ],
   "text": "7 PM. THE WELL"
  },
  {
   "who": "narr",
   "say": "Then a bright light streaked across the sky, and dropped behind the trees.",
   "cam": "wide",
   "do": [
    [
     "fire",
     "show"
    ],
    [
     "fire",
     "drift:20,40,1"
    ]
   ],
   "sfx": "horn",
   "text": "A LIGHT FELL"
  },
  {
   "who": "billy",
   "say": "Did you see that? A flying saucer! It came down past the field!",
   "cam": "close:billy",
   "do": [
    [
     "billy",
     "jump"
    ],
    [
     "fire",
     "vanish"
    ]
   ],
   "text": "A FLYING SAUCER?"
  },
  {
   "who": "lucky",
   "say": "A saucer? You've been in the sun too long, Billy Ray.",
   "cam": "two:billy,lucky",
   "do": [
    [
     "lucky",
     "enter:left"
    ],
    [
     "lucky",
     "turn:billy"
    ]
   ]
  },
  {
   "who": "moth",
   "say": "Nobody ever believes the first one who sees it. That's always how it starts.",
   "cam": "close:moth",
   "do": [
    [
     "moth",
     "eyes_big"
    ]
   ],
   "sfx": "suspicious"
  },
  {
   "who": "narr",
   "say": "Nobody believed him. But an hour later, the farm dog started barking.",
   "cam": "close:odo",
   "do": [
    [
     "odo",
     "turn:moth"
    ]
   ],
   "text": "THE DOG BARKED"
  },
  {
   "who": "narr",
   "say": "Then the dog stopped barking, and crawled under the house. It would not come out.",
   "cam": "wide",
   "do": [
    [
     "all",
     "shake"
    ]
   ],
   "sfx": "alarm",
   "text": "THEN IT HID"
  },
  {
   "who": "narr",
   "say": "Out of the dark field came a small, glowing figure, walking straight toward the house.",
