     "gob",
     "to:30,30,0"
    ]
   ],
   "sfx": "suspicious",
   "text": "UNTIL SUNRISE"
  },
  {
   "who": "narr",
   "say": "Some experts say they were great horned owls. Owls have yellow eyes, and fly without a sound.",
   "cam": "wide",
   "do": [
    [
     "odo",
     "turn:front"
    ]
   ],
   "text": "OWLS?"
  },
  {
   "who": "narr",
   "say": "But the families never changed their story. Not once, for the rest of their lives.",
