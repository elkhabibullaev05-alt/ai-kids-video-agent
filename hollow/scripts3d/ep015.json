   "do": [
    [
     "l1",
     "shake"
    ],
    [
     "l3",
     "shake"
    ]
   ],
   "sfx": "suspicious",
   "text": "AD 82"
  },
  {
   "who": "narr",
   "say": "The legion held on. And it kept marching.",
   "cam": "wide",
   "do": [
    [
     "l1",
     "to:1,16"
    ],
    [
     "l2",
     "to:3.5,16"
    ],
    [
     "l3",
     "to:1,19"
    ],
    [
     "l4",
     "to:3.5,19"
    ]
   ]
  },
  {
   "who": "narr",
   "say": "The last words they left in Britain were carved in stone, at York, in the year 108.",
   "cam": "close:l2",
   "do": [
    [
     "l2",
     "turn:front"
    ]
   ],
   "text": "THE LAST STONE: 108"
  },
  {
   "who": "narr",
   "say": "After that, silence. No battle. No goodbye. Nothing.",
