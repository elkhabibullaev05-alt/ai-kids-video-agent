   "do": [
    [
     "moth",
     "eyes_big"
    ]
   ],
   "text": "ERASED FROM THE LIST"
  },
  {
   "who": "narr",
   "say": "Some said they were wiped out in the misty hills of the north.",
   "cam": "wide",
   "text": "LOST IN THE MIST?"
  },
  {
   "who": "odo",
   "say": "Five thousand soldiers can't just disappear.",
   "cam": "close:odo",
   "do": [
    [
     "odo",
     "eyes_big"
    ]
   ]
  },
  {
   "who": "narr",
   "say": "But in 1959, diggers in the Netherlands found a roof tile stamped with the Ninth's name.",
