   "do": [
    [
     "tile",
     "vanish"
    ]
   ],
   "text": "SENT EAST?"
  },
  {
   "who": "narr",
   "say": "Nobody knows how the Ninth ended. Not one record tells us.",
   "cam": "two:odo,moth",
   "do": [
    [
     "odo",
     "sad"
    ]
   ],
   "text": "NOBODY KNOWS"
  },
