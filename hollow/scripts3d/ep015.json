   "sfx": "suspicious",
   "text": "THE WINGLESS EAGLE"
  },
  {
   "who": "narr",
   "say": "A writer, Rosemary Sutcliff, imagined it was the lost eagle of the Ninth. She wrote a famous book.",
   "cam": "prop:eagle",
   "do": [
    [
     "eagle",
     "bounce"
    ]
   ]
  },
  {
   "who": "narr",
   "say": "But the ghost story is even stranger. And it is written down too.",
   "cam": "wide",
   "do": [
    [
     "eagle",
     "vanish"
    ]
   ],
   "sfx": "suspicious"
  },
  {
   "who": "narr",
   "say": "1953. An eighteen-year-old plumber, Harry Martindale, was alone in a cellar in York.",
   "cam": "close:harry",
   "do": [
    [
     "harry",
     "enter:left"
    ],
    [
     "harry",
     "turn:front"
    ]
   ],
   "text": "ALONE IN THE CELLAR"
  },
  {
   "who": "narr",
   "say": "Then he heard a trumpet. Far away. Getting louder.",
