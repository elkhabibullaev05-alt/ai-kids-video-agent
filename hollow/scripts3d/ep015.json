   "do": [
    [
     "harry",
     "eyes_big"
    ]
   ],
   "sfx": "suspicious",
   "text": "A TRUMPET... LOUDER"
  },
  {
   "who": "narr",
   "say": "A soldier in a plumed helmet walked straight out of the wall.",
