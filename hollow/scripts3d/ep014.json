   "do": [
    [
     "coal",
     "vanish"
    ],
    [
     "w3",
     "show"
    ]
   ],
   "text": "JACK-O'-LANTERN"
  },
  {
   "who": "narr",
   "say": "Stingy Jack tricked the Devil twice. He carried his glowing ember inside a carved turnip.",
