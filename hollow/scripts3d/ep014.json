   "do": [
    [
     "w3",
     "drift:-2,14,2.4"
    ]
   ],
   "text": "SCIENTISTS TRIED"
  },
  {
   "who": "narr",
   "say": "In 1776, Alessandro Volta said a spark might set the swamp gas on fire.",
   "cam": "overhead",
   "text": "1776"
  },
  {
   "who": "narr",
   "say": "Gas from rotting plants bubbles up out of the mud. Maybe it burns with a cold, blue flame.",
