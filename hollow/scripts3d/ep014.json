   "do": [
    [
     "blesson",
     "to:2,12"
    ],
    [
     "w4",
     "drift:4,19,1.7"
    ]
   ],
   "text": "IT MOVED AWAY"
  },
  {
   "who": "narr",
   "say": "He blamed the air he pushed as he walked. But the light kept running, just like the stories said.",
   "cam": "wide",
   "do": [
    [
     "w4",
     "drift:7,24,1.9"
    ]
   ]
  },
  {
   "who": "narr",
   "say": "Even in 1938, an Irish schoolboy wrote that his father once followed a rolling red ball of fire.",
