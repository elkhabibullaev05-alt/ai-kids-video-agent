   "do": [
    [
     "odo",
     "eyes_big"
    ]
   ]
  },
  {
   "who": "moth",
   "say": "The pumpkins came later. In America.",
   "cam": "close:moth",
   "do": [
    [
     "turnip",
     "vanish"
    ]
   ]
  },
  {
   "who": "narr",
   "say": "Here is the strange part. Real scientists tried to catch the light.",
