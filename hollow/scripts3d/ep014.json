   "do": [
    [
     "w3",
     "bounce"
    ]
   ],
   "sfx": "suspicious"
  },
  {
   "who": "narr",
   "say": "And in 1832, a German officer, Major Louis Blesson, walked into a marsh at night.",
   "cam": "close:blesson",
   "do": [
    [
     "blesson",
     "enter:right"
    ]
   ],
   "text": "1832"
  },
  {
   "who": "blesson",
   "say": "There. A flame over the water. I shall get closer.",
   "cam": "close:blesson",
   "do": [
    [
     "blesson",
     "turn:front"
    ],
    [
     "w4",
     "show"
    ]
   ]
  },
  {
   "who": "narr",
   "say": "He wrote that as he came near, the flame moved away from him.",
