   "do": [
    [
     "ichabod",
     "enter:left"
    ]
   ]
  },
  {
   "who": "ichabod",
   "say": "Ghosts? Nonsense! I am a learned man. I fear nothing.",
   "cam": "close:ichabod",
   "do": [
    [
     "ichabod",
     "happy"
    ]
   ]
  },
  {
   "who": "narr",
   "say": "One autumn night, Ichabod rode home alone from a party, right past this churchyard.",
   "cam": "wide",
   "do": [
    [
     "ichabod",
     "to:0,12"
    ]
   ]
  },
  {
   "who": "narr",
   "say": "Then, in the dark, he saw a huge shape standing very still beside the road.",
