   "do": [
    [
     "rider",
     "turn:front"
    ]
   ],
   "sfx": "suspicious"
  },
  {
   "who": "narr",
   "say": "The tale says a cannonball took his head in battle. So every night, he rides out to find it.",
   "cam": "close:rider",
   "do": [
    [
     "rider",
     "shake"
    ]
   ]
  },
  {
   "who": "narr",
   "say": "Here is the strange part. There is a real record from the Battle of White Plains, in 1776.",
   "cam": "overhead",
   "text": "1776"
  },
  {
   "who": "narr",
   "say": "A soldier lost his head to a cannonball there. Nobody ever wrote down where he was buried.",
   "cam": "wide",
   "sfx": "suspicious"
  },
  {
   "who": "moth",
   "say": "So he could be under any of these stones.",
   "cam": "close:moth",
   "do": [
    [
     "odo",
     "eyes_big"
    ]
   ]
  },
  {
   "who": "odo",
   "say": "Please don't say that.",
   "cam": "close:odo",
   "do": [
    [
     "odo",
     "shake"
    ]
   ]
  },
  {
   "who": "narr",
   "say": "Irving's story follows a schoolteacher named Ichabod Crane. Tall, skinny, and scared of everything.",
