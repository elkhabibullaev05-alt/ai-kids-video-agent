   "say": "Who... who is there?",
   "cam": "close:ichabod",
   "do": [
    [
     "ichabod",
     "shake"
    ]
   ]
  },
  {
   "who": "narr",
   "say": "It did not answer. It just began to follow him. Clip. Clop. Faster and faster.",
