  {
   "who": "narr",
   "say": "This place is real. Sleepy Hollow, New York. Its stone church was built around 1685.",
   "cam": "two:odo,moth",
   "do": [
    [
     "odo",
     "eyes_big"
    ]
   ],
   "text": "A REAL PLACE"
  },
  {
   "who": "odo",
   "say": "Mothwick... did you hear hooves?",
   "cam": "close:odo",
   "do": [
