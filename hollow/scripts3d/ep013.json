     "odo",
     "turn:rider"
    ]
   ]
  },
  {
   "who": "moth",
   "say": "Hooves. And no breathing.",
   "cam": "close:moth",
   "do": [
    [
     "moth",
     "shake"
    ]
   ]
  },
  {
   "who": "narr",
   "say": "The legend was first written down in 1820, by a writer named Washington Irving.",
   "cam": "overhead",
   "text": "WRITTEN DOWN IN 1820"
  },
  {
   "who": "narr",
   "say": "As a boy, Irving explored these hills and listened to the old ghost stories.",
