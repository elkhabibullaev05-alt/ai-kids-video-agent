   "do": [
    [
     "jack",
     "bounce"
    ]
   ],
   "text": "SPRINGS IN HIS HEELS"
  },
  {
   "who": "narr",
   "say": "January eighteen thirty-eight. The Lord Mayor of London stood up with a letter.",
   "cam": "close:mayor",
   "do": [
    [
     "mayor",
     "enter:left"
    ]
   ],
   "sfx": "suspicious",
   "text": "JANUARY 1838"
  },
  {
   "who": "mayor",
   "say": "A man is frightening people at night, dressed as a ghost, a bear, and a devil!",
   "cam": "close:mayor",
   "do": [
    [
     "mayor",
     "shake"
    ]
   ]
  },
  {
   "who": "narr",
   "say": "The letter said he did it for a bet. But nobody could catch him.",
