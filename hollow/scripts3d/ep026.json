   ],
   "sfx": "suspicious",
   "text": "RED EYES"
  },
  {
   "who": "narr",
   "say": "This is a true legend, from the records of old London. They called him Spring-heeled Jack.",
   "cam": "overhead",
   "do": [
    [
     "jack",
     "jump"
    ]
   ],
   "text": "SPRING-HEELED JACK"
  },
  {
   "who": "narr",
   "say": "London, eighteen thirty-seven. The streets were dark, lit only by gas lamps.",
   "cam": "close:odo",
   "do": [
    [
     "odo",
     "turn:front"
    ]
   ],
   "text": "LONDON, 1837"
  },
  {
   "who": "narr",
   "say": "People said a figure sprang out of the dark, in front of a carriage.",
   "cam": "wide",
   "do": [
    [
     "jack",
     "to:0,12,0"
    ]
   ],
   "sfx": "alarm",
   "text": "OUT OF THE DARK"
  },
  {
   "who": "narr",
   "say": "Then it leapt over a nine-foot wall. And it was laughing.",
   "cam": "close:jack",
   "do": [
    [
     "jack",
     "to:2.5,15.6,1.45"
    ],
    [
     "jack",
     "jump"
    ]
   ],
   "sfx": "horn",
   "text": "A 9-FOOT WALL"
  },
  {
   "who": "moth",
   "say": "Nobody can jump that high. Nobody with normal feet.",
   "cam": "close:moth",
   "do": [
    [
     "moth",
     "eyes_big"
    ]
   ]
  },
  {
   "who": "narr",
   "say": "So the newspapers gave him a name. Jack, with springs in his heels.",
