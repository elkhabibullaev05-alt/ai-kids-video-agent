   "do": [
    [
     "bell",
     "bounce"
    ],
    [
     "moth",
     "shake"
    ]
   ],
   "sfx": "alarm",
   "text": "BELLS RANG BY THEMSELVES"
  },
  {
   "who": "narr",
   "say": "In 1929, a London newspaper printed the story. And a ghost hunter came. Harry Price.",
   "cam": "close:price",
   "do": [
    [
     "price",
     "enter:left"
    ]
   ],
   "text": "THE GHOST HUNTER"
  },
  {
   "who": "price",
   "say": "Ring again, bells. I am writing everything down.",
   "cam": "two:price,odo",
   "do": [
    [
     "price",
     "turn:front"
    ],
    [
     "bell",
     "spin"
    ]
   ]
  },
  {
   "who": "narr",
   "say": "The Smiths moved out that same summer.",
