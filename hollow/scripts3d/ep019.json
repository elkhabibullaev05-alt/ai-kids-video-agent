   "sfx": "suspicious",
   "text": "THEY LEFT"
  },
  {
   "who": "narr",
   "say": "In 1930, a vicar named Lionel Foyster moved in. With his young wife, Marianne.",
   "cam": "close:marianne",
   "do": [
