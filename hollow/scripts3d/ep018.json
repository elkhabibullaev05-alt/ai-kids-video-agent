   "do": [
    [
     "sarah",
     "rise"
    ]
   ],
   "sfx": "suspicious",
   "text": "THEY FELL THROUGH"
  },
  {
   "who": "narr",
   "say": "This is a true story, from real records. A house in San Jose, California.",
   "cam": "wide",
   "do": [
    [
     "odo",
     "turn:sarah"
    ]
   ],
   "text": "SAN JOSE, CALIFORNIA"
  },
  {
   "who": "narr",
   "say": "A house where the building never stopped. Day and night. For thirty-eight years.",
   "cam": "close:builder",
   "do": [
    [
     "builder",
     "enter:left"
    ]
   ],
   "sfx": "suspicious",
   "text": "38 YEARS OF BUILDING"
  },
  {
   "who": "narr",
   "say": "It belonged to Sarah Winchester. Her baby daughter died in 1866.",
   "cam": "close:sarah",
   "do": [
    [
     "sarah",
     "sad"
    ]
   ],
   "text": "SARAH WINCHESTER"
  },
  {
   "who": "narr",
   "say": "Fifteen years later, her husband died too. He ran the family's famous rifle company.",
   "cam": "two:sarah,odo",
   "do": [
    [
     "sarah",
     "turn:front"
    ]
   ],
   "text": "1881: ALONE"
  },
  {
   "who": "narr",
   "say": "She was left with a huge fortune. And she moved all the way west.",
   "cam": "wide",
   "do": [
    [
     "sarah",
     "to:3,10"
    ]
   ],
   "text": "ALL THE WAY WEST"
  },
  {
   "who": "moth",
   "say": "Why would anyone move so far away?",
   "cam": "close:moth",
   "do": [
    [
     "moth",
     "turn:sarah"
    ]
   ]
  },
  {
   "who": "narr",
   "say": "In 1884 she bought a small farmhouse with eight rooms. Then she started building.",
   "cam": "prop:door1",
   "do": [
    [
     "builder",
     "jump"
    ]
   ],
   "text": "1884: EIGHT ROOMS"
  },
  {
   "who": "builder",
   "say": "More rooms. Always more rooms. We never get a day off!",
   "cam": "close:builder",
   "do": [
    [
     "builder",
     "shake"
    ]
   ]
  },
  {
   "who": "narr",
   "say": "No architect. No final plan. Rooms were built, torn down, and built again.",
   "cam": "two:builder,odo",
   "do": [
    [
     "builder",
     "to:-6,10"
    ]
   ],
   "sfx": "suspicious",
   "text": "NO PLAN"
  },
  {
   "who": "narr",
   "say": "By the end, the house had about one hundred sixty rooms. And ten thousand windows.",
